# Bob's Burger backend service - Version 1.1 (Day 5)
# Copy to /etc/systemd/system/bobs-burger.service
# What changed from 1.0: it now reads its database settings from /etc/bobs-burger.env
[Unit]
Description=Bob's Burger backend
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/bobs-burger
# Database name, user, password and table name live here, not in the code
EnvironmentFile=/etc/bobs-burger.env
ExecStart=/home/ec2-user/bobs-burger/venv/bin/gunicorn --bind 0.0.0.0:80 --workers 2 app:app
# Lets a normal user listen on port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
