# Bob's Burger settings - Version 1.3 (Day 8)
# What changed from 1.2: new optional line EFS_MOUNT (the folder where the EFS file system is mounted).
# What changed from 1.1: new line SQS_QUEUE_URL (the address of your order queue, from the SQS console).
# This is an EXAMPLE. On the server, create /etc/bobs-burger.env with your real values:
#   sudo nano /etc/bobs-burger.env
#   sudo chown root:root /etc/bobs-burger.env
#   sudo chmod 600 /etc/bobs-burger.env
# Never put the real password in a file that you share, upload to S3 or screenshot.
# The app refuses to start if a value still contains example text such as YOUR-... or xxxxxxxxxxxx.
DB_HOST=your-database.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=bbapp
DB_PASSWORD=put-the-app-user-password-here
DB_NAME=bobsburger
DDB_TABLE=bobs-burger-order-status
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR-ACCOUNT-ID/bobs-burger-order-queue
# Day 8: remove this line if EFS is not mounted yet. With it, each order also writes a receipt file to /mnt/efs/receipts.
EFS_MOUNT=/mnt/efs
